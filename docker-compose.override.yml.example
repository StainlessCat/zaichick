# =========================================================================
# ZAYCHICK 2.0 — Пример конфигурации для разработки (docker-compose.override.yml)
#
# Скопируйте этот файл как docker-compose.override.yml при необходимости:
#   cp docker-compose.override.yml.example docker-compose.override.yml
# =========================================================================

services:
  db:
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-zaychick}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-zaychick_dev_password}
      POSTGRES_DB: ${POSTGRES_DB:-zaychick}
    ports:
      - "127.0.0.1:5432:5432"

  backend:
    environment:
      ENVIRONMENT: development
      DATABASE_URL: "postgresql+asyncpg://${POSTGRES_USER:-zaychick}:${POSTGRES_PASSWORD:-zaychick_dev_password}@db:5432/${POSTGRES_DB:-zaychick}"
      JWT_SECRET_KEY: ${JWT_SECRET_KEY:-dev-secret-key-32-bytes-minimum-length!}
      COOKIE_SECURE: "false"
      COOKIE_SAMESITE: lax
      INITIAL_ADMIN_PASSWORD: ${INITIAL_ADMIN_PASSWORD:-admin123}
      CORS_ORIGINS: "http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1,http://127.0.0.1:5173,http://127.0.0.1:8000"
    volumes:
      - ./backend/app:/app/backend/app
      - ./backend/alembic:/app/backend/alembic
      - ./backend/pyproject.toml:/app/backend/pyproject.toml:ro
    command: >
      sh -c "alembic upgrade head &&
             python -m app.cli.bootstrap_admin &&
             uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/backend/app"
    ports:
      - "127.0.0.1:8000:8000"
