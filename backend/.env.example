# PostgreSQL 16+ (fail-fast: без JSON/SQLite фоллбека)
DATABASE_URL=postgresql+asyncpg://zaychick:zaychick_dev_password@127.0.0.1:5432/zaychick

# Security / JWT (HttpOnly Cookie + Bearer header)
JWT_SECRET_KEY=change-this-secret-key-in-production-min-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=zaychick_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial bootstrap admin password (for CLI seed / initial deploy)
INITIAL_ADMIN_PASSWORD=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
