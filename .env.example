# =========================================================================
# ZAYCHICK 2.0 — Пример файла окружения (.env)
# Скопируйте этот файл в .env и укажите надёжные уникальные значения:
#   cp .env.example .env
# =========================================================================

# --- PostgreSQL 16+ ---
POSTGRES_USER=zaychick
# ВНИМАНИЕ: Обязательно задайте надёжный пароль для БД!
# Пример генерации: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-strong-db-password-in-production
POSTGRES_DB=zaychick

# Строка подключения для локального запуска / миграций (если запускается вне Docker)
# В docker-compose.yml эта строка формируется автоматически с хостом db
DATABASE_URL=postgresql+asyncpg://zaychick:replace-with-strong-db-password-in-production@127.0.0.1:5432/zaychick

# --- Безопасность / JWT (HttpOnly Cookie + Bearer) ---
# ВНИМАНИЕ: Секретный ключ подписи JWT токенов (минимум 32 байта).
# Обязательно сгенерируйте случайный ключ командой:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-secure-32-byte-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Безопасность Cookies ---
COOKIE_NAME=zaychick_access_token
# В production с HTTPS установите COOKIE_SECURE=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Начальный администратор ---
# Пароль для первичного создания учётной записи администратора (при первом запуске/seed)
INITIAL_ADMIN_PASSWORD=

# --- CORS Origins (через запятую) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1
